# ============================================================
# TNCC Website — Environment Variables Example
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# DO NOT commit .env.local to version control.
# DO NOT put real secrets in this file.
# ============================================================

# Supabase Project URL (safe to be public)
NEXT_PUBLIC_SUPABASE_URL=https://hdpzpbzhciyjvewcaxkl.supabase.co

# Supabase Anon/Publishable Key (client-safe, read-only anonymous key)
# Find it at: Supabase Dashboard → Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: If Supabase provides a separate publishable key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# ============================================================
# SECURITY WARNING
# ============================================================
# NEVER put these in this file or any source code:
#   - service_role key
#   - database password
#   - JWT secret
#   - any other secret key
# ============================================================
